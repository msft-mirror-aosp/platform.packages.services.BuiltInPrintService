package: "com.android.bips.flags"
container: "system"

flag {
    name: "printing_telemetry"
    namespace: "printing"
    description: "Metrics tracking final print job status, printer discovery, printer capabilities, and major UI actions."
    bug: "390478410"
}

flag {
    name: "enable_print_debug_option"
    namespace: "printing"
    description: "Enable extra debug logging by checking a runtime system property."
    bug: "397418860"
}

flag {
    name: "ipp_print_service_integration"
    namespace: "printing"
    description: "Suppress printers if they are supported by IppPrintService."
    bug: "444253321"
}

flag {
    name: "collate_by_default"
    namespace: "printing"
    description: "Always request collated printouts if the printer supports it."
    bug: "468447980"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "mopria_26q2_fixes"
    namespace: "printing"
    description: "Mopria-provided bug fixes for 26Q2 release."
    bug: "470364937"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}
